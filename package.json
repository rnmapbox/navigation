{
  "name": "@rnmapbox/navigation",
  "version": "0.1.0-alpha.4",
  "description": "Turn-by-turn navigation for React Native with the Mapbox Navigation SDK v3 (iOS & Android): routing, active guidance and a drop-in NavigationView. New Architecture and Expo config plugin, built on @rnmapbox/maps.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "rnmapbox-navigation-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "cpp",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "app.plugin.js",
    "plugin",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @rnmapbox/navigation-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "docs": "typedoc"
  },
  "keywords": [
    "react-native",
    "react-native-mapbox",
    "rnmapbox",
    "mapbox",
    "mapbox-navigation",
    "mapbox-navigation-sdk",
    "navigation-sdk",
    "turn-by-turn",
    "turn-by-turn-navigation",
    "navigation",
    "directions",
    "routing",
    "route",
    "guidance",
    "voice-guidance",
    "gps",
    "ios",
    "android",
    "expo",
    "expo-config-plugin",
    "new-architecture",
    "fabric",
    "turbo-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnmapbox/navigation.git"
  },
  "author": "Miklós Fazekas <mfazekas@szemafor.com> (https://github.com/mfazekas)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rnmapbox/navigation/issues"
  },
  "homepage": "https://rnmapbox.github.io/docs/navigation/overview",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.86.2",
    "@rnmapbox/maps": "10.3.16",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "expo": "~58.0.16",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.43.2",
    "react-test-renderer": "19.2.3",
    "turbo": "^2.10.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@rnmapbox/maps": ">=10.3.16 <10.4.0",
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example",
    "expo-example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "rnmapbox_navigation_specs",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.rnmapbox.rnmbxnav"
    },
    "ios": {
      "componentProvider": {
        "RNMBXNavigationView": "RNMBXNavigationViewComponentView",
        "RNMBXNavigationViewport": "RNMBXNavigationViewportComponentView"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.63.1"
  },
  "mapboxNavigation": {
    "ios": "3.33.0",
    "android": "3.33.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/expo-example/node_modules",
      "<rootDir>/lib/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.{ts,tsx}",
      "<rootDir>/plugin/__tests__/**/*.test.js"
    ]
  }
}
